# Copy to .env.local and fill in (Supabase Dashboard > Project Settings > API).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Optional: set this only after enabling Cloudflare Turnstile CAPTCHA in Supabase Auth.
VITE_TURNSTILE_SITE_KEY=
# Your Supabase Auth email. Before deployment, add the same value as the
# VITE_STORY_OWNER_EMAIL GitHub Actions secret to enable your private preview.
VITE_STORY_OWNER_EMAIL=
